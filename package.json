{
  "name": "next-app",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "scripts": {
    "postinstall": "lefthook install && node scripts/setup-git-filter.mjs",
    "predev": "bun run db:prepare",
    "dev": "next dev --turbopack",
    "db:down": "docker compose down",
    "db:generate": "dotenvx run -f .env.development -q -- drizzle-kit generate",
    "db:migrate": "dotenvx run -f .env.development -q -- tsx scripts/db/migrate.ts",
    "db:seed": "dotenvx run -f .env.development -q -- tsx scripts/db/seed.ts",
    "db:prepare": "docker compose up -d --wait && bun run db:migrate && bun run db:seed",
    "db:reset": "docker compose up -d --wait && dotenvx run -f .env.development -q -- tsx scripts/db/reset.ts && bun run db:migrate && bun run db:seed",
    "test": "dotenvx run -f .env.development -q -- vitest run",
    "test:e2e": "dotenvx run -f .env.development -q -- playwright test",
    "build": "next build",
    "start": "next start",
    "lint": "oxlint && eslint",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "encrypt": "dotenvx encrypt -f .env.development",
    "decrypt": "dotenvx decrypt -f .env.development"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^2.33.0",
    "@dotenvx/next-env": "^2.4.3",
    "@phosphor-icons/react": "^2.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "next": "16.1.7",
    "next-themes": "^0.4.6",
    "pg": "^8.23.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "shadcn": "^4.7.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@next/env": "npm:@dotenvx/next-env"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@oxlint/plugins": "1.87.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.7",
    "lefthook": "^2.1.17",
    "oxlint": "1.87.0",
    "postcss": "^8",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "tailwindcss": "^4.2.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
